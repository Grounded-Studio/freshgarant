---
import Base from '~/layouts/Base.astro';
import SavingsCalc from '~/components/SavingsCalc.tsx';
import { t, PLAY_STORE_URL } from '~/i18n/strings';

const lang = 'en';
const s = t(lang);
---
<Base
  lang={lang}
  path="/savings"
  title="Savings calculator — FreshGarant"
  description={s.savings.heroLead}
>
  <section class="section">
    <div class="container">
      <span class="section-kicker">{s.savings.heroKicker}</span>
      <h1>{s.savings.heroTitle}</h1>
      <p class="section-sub">{s.savings.heroLead}</p>

      <!-- `client:load` = React island hydrates immediately on page load. -->
      <SavingsCalc
        client:load
        lang={lang}
        strings={{
          weeklySpendLabel: s.savings.weeklySpendLabel,
          wastePercentLabel: s.savings.wastePercentLabel,
          wasteHint: s.savings.wasteHint,
          resultTitle: s.savings.resultTitle,
          perMonth: s.savings.perMonth,
          perYear: s.savings.perYear,
          co2Saved: s.savings.co2Saved,
          co2Hint: s.savings.co2Hint,
          currentWasteLabel: s.savings.currentWasteLabel,
          newWasteLabel: s.savings.newWasteLabel,
        }}
      />

      <!-- Methodology notice — keeps us honest. -->
      <div class="card" style="margin-top: 40px;">
        <h3 style="font-size: 1.1rem; margin-bottom: 8px;">
          {s.savings.sourcesTitle}
        </h3>
        <p style="color: var(--fg-text-muted); font-size: 14px; margin-bottom: 14px;">
          {s.savings.reductionNote}
        </p>
        <ul style="padding-left: 20px; color: var(--fg-text-muted); font-size: 14px; margin: 0;">
          {s.savings.sources.map((src) => <li>{src}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band">
        <h2>{s.savings.ctaBand}</h2>
        <a href={PLAY_STORE_URL} class="btn btn-primary" target="_blank" rel="noopener">
          {s.savings.ctaBtn} →
        </a>
      </div>
    </div>
  </section>
</Base>
