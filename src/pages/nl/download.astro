---
import Base from '~/layouts/Base.astro';
import { t, PLAY_STORE_URL } from '~/i18n/strings';

const lang = 'nl';
const s = t(lang);
---
<Base
  lang={lang}
  path="/nl/download"
  title="Download FreshGarant"
  description={s.download.heroLead}
>
  <section class="section">
    <div class="container">
      <span class="section-kicker">{s.download.heroKicker}</span>
      <h1>{s.download.heroTitle}</h1>
      <p class="section-sub">{s.download.heroLead}</p>

      <div class="download-grid">
        <div class="download-card download-card-primary">
          <div>
            <h2 style="color: #fff; margin-bottom: 6px;">
              {s.download.androidTitle}
            </h2>
            <p style="color: rgba(255,255,255,0.85); font-size: 14px; margin-bottom: 20px;">
              {s.download.androidSub}
            </p>
            <a
              href={PLAY_STORE_URL}
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
              style="background: #fff; color: var(--fg-primary-dark);"
            >
              {s.home.ctaDownload} →
            </a>
          </div>
          <div class="download-qr">
            <div class="image-slot" style="min-height: 160px; background: #fff;">
              {s.slot.qrCode}
            </div>
            <small>{s.download.qrLabel}</small>
          </div>
        </div>

        <div class="download-card download-card-muted">
          <h2 style="margin-bottom: 6px;">{s.download.comingSoonTitle}</h2>
          <p style="color: var(--fg-text-muted); font-size: 14px; margin: 0;">
            {s.download.comingSoonBody}
          </p>
          <a href="/nl/contact" class="btn btn-ghost" style="margin-top: 18px;">
            {s.footer.links.contact} →
          </a>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top: 72px; gap: 32px;">
        <div class="card">
          <div class="chip chip-pro" style="background: rgba(46,125,50,0.15); color: var(--fg-primary-dark); margin-bottom: 14px;">
            {s.features.freeLabel}
          </div>
          <h3>{s.download.inFreeTitle}</h3>
          <ul class="download-list">
            {s.download.inFreeItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="card">
          <div class="chip chip-pro" style="margin-bottom: 14px;">
            {s.features.proLabel}
          </div>
          <h3>{s.download.inProTitle}</h3>
          <ul class="download-list">
            {s.download.inProItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <p style="text-align: center; margin-top: 40px; color: var(--fg-text-muted); font-size: 14px; font-style: italic;">
        {s.download.oneTrial}
      </p>
    </div>
  </section>
</Base>
