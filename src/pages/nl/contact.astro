---
import Base from '~/layouts/Base.astro';
import { t, CONTACT_EMAIL } from '~/i18n/strings';

const lang = 'nl';
const s = t(lang);
---
<Base
  lang={lang}
  path="/nl/contact"
  title="Contact — FreshGarant"
  description={s.contact.heroLead}
>
  <section class="section">
    <div class="container">
      <span class="section-kicker">{s.contact.heroKicker}</span>
      <h1>{s.contact.heroTitle}</h1>
      <p class="section-sub">{s.contact.heroLead}</p>

      <div class="grid grid-2" style="gap: 32px; align-items: start;">
        <div class="card contact-card">
          <div class="contact-icon">✉</div>
          <h3>{s.contact.emailLabel}</h3>
          <a
            href={`mailto:${CONTACT_EMAIL}?subject=FreshGarant`}
            class="contact-email"
          >
            {CONTACT_EMAIL}
          </a>
          <p style="color: var(--fg-text-muted); font-size: 14px; margin-top: 20px; margin-bottom: 0;">
            {s.contact.tipTitle}
          </p>
          <p style="color: var(--fg-text-muted); font-size: 13.5px; margin-top: 4px;">
            {s.contact.tipBody}
          </p>
        </div>

        <div class="card">
          <h3>{s.contact.responseTitle}</h3>
          <ul class="download-list" style="margin-top: 10px;">
            {s.contact.response.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
